      "api_key_env": "OPENAI_API_KEY",
      "temperature": 0.2,
      "max_tokens": 1500
    },
    {
      "name": "qwen",
      "provider": "qwen",
      "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "model": "qwen-plus",
      "api_key_env": "DASHSCOPE_API_KEY",
      "temperature": 0.2,
      "max_tokens": 1500
    }
  ],
  "crawler": {
    "provider": "firecrawl",
    "base_url": "https://api.firecrawl.dev",
